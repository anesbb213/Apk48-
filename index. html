        const currencyText = document.getElementById('currencySelect').selectedOptions[0].text;
        const resBox = document.getElementById('currencyResult');

        if (isNaN(amount) || amount <= 0) {
            resBox.style.display = 'block';
            resBox.innerText = "يرجى إدخال مبلغ صحيح";
            return;
        }

        const converted = (amount * rate).toFixed(2);
        resBox.style.display = 'block';
        resBox.innerText = `${amount} دج ≈ ${converted} ${currencyText}`;
    }

    // التهيئة الأولية
    renderWilayas();
    renderPresidents();
    renderWorld();
    populateSelects();
</script>

</body>
</html>
